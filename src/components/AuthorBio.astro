---
import { author } from '../data/author';
---

<section class="author-bio">
	<div class="container">
		<h2>Over de auteur</h2>
		<div class="author-bio__row">
			<img src={author.photo} alt={author.name} class="author-bio__photo" width="188" height="300" />
			<p><strong>{author.name}</strong>: {author.bio}</p>
		</div>
	</div>
</section>
