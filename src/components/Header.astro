---
import Nav from './Nav.astro';
import { siteMeta } from '../data/navigation';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="site-header__brand">
			<img src="/images/home/header-avatar-geworteld.jpg" alt="" class="site-header__accent" />
			<span>{siteMeta.title}</span>
		</a>
		<div class="site-header__right">
			<Nav />
			<a href="/zoeken/" class="site-header__search" aria-label="Zoeken">🔍</a>
			<img src="/images/home/header-avatar-sola.jpg" alt="" class="site-header__accent" />
		</div>
	</div>
	<slot />
</header>
