---
// Layout voor gewone inhoudspagina's (uit de content collection): titel + container.
// Optioneel: een "Bijbelteksten"-zijbalk naast de hoofdtekst (zie o.a. de
// Verbond & Doop-pagina's, die dit patroon overnemen van de oorspronkelijke site).
import BaseLayout from './BaseLayout.astro';

interface ScriptureItem {
	ref: string;
	text: string;
}

interface Props {
	title: string;
	description?: string;
	scripture?: ScriptureItem[];
	// Zet dit op false wanneer de slot zelf al iets anders dan platte
	// tekst/afbeeldingen bevat (bv. een .card-grid), zoals bij de
	// categorie-hubs onder Publicaties — die wikkelen hun eigen introtekst
	// dan zelf in .prose. Standaard true voor gewone content-pagina's, zodat
	// losse afbeeldingen overal een consistente standaardmaat krijgen.
	prose?: boolean;
}

const { title, description, scripture, prose = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class="container page">
		<h1 class="page__title">{title}</h1>
		{scripture && scripture.length > 0 ? (
			<div class="page-with-scripture">
				<div class="page-with-scripture__main prose">
					<slot />
				</div>
				<aside class="scripture-aside" aria-label="Bijbelteksten">
					<h2>Bijbelteksten</h2>
					{scripture.map((item) => (
						<blockquote>
							<p>{item.text}</p>
							<cite>{item.ref}</cite>
						</blockquote>
					))}
				</aside>
			</div>
		) : prose ? (
			<div class="prose">
				<slot />
			</div>
		) : (
			<slot />
		)}
	</div>
</BaseLayout>
