---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SolasBar from '../components/SolasBar.astro';
import { siteMeta } from '../data/navigation';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	// De homepage heeft de sola's al verwerkt in haar eigen (grotere) hero,
	// dus die zet dit op false om dubbele weergave te voorkomen.
	showSolasBar?: boolean;
	// Voor pagina's die niet in zoekmachines mogen verschijnen (bv. /statistiek/).
	noindex?: boolean;
}

const { title, description, showSolasBar = true, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${siteMeta.title}` : siteMeta.title;
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
	</head>
	<body>
		<Header />
		{showSolasBar && <SolasBar />}
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
