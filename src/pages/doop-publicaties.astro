---
// Categorie-hub "Doop" onder Publicaties: intro + overzicht van artikelen
// met category: 'doop' (uit content/publications/ en content/posts/).
import PageLayout from '../layouts/PageLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCategoryItems } from '../lib/publications';

const items = await getCategoryItems('doop');
---

<PageLayout title="Artikelen m.b.t. de doop" description="Verdieping en theologische reflectie over de betekenis van de doop." prose={false}>
	{items.length === 0 ? (
		<p>Er zijn nog geen artikelen in deze categorie toegevoegd.</p>
	) : (
		<ul class="card-grid card-grid--large">
			{items.map((item) => (
				<ArticleCard href={`/${item.id}/`} image={item.image} title={item.title} description={item.description} />
			))}
		</ul>
	)}
</PageLayout>
