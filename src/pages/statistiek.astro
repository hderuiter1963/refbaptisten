---
// Verborgen statistiekpagina: niet in het menu, niet in zoekmachines
// (noindex), alleen bereikbaar via de directe URL /statistiek/.
// Leest live uit Vercel KV, dus deze route is server-rendered i.p.v. statisch.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { kv } from '@vercel/kv';

let total = 0;
let weekCounts: { label: string; count: number }[] = [];
let monthCounts: { label: string; count: number }[] = [];
let errorMessage = '';

try {
	const [weekKeys, monthKeys, totalCount] = await Promise.all([
		kv.smembers('pv:weeks'),
		kv.smembers('pv:months'),
		kv.get<number>('pv:total'),
	]);

	total = totalCount ?? 0;

	const sortedWeeks = (weekKeys as string[]).sort().reverse().slice(0, 12);
	const sortedMonths = (monthKeys as string[]).sort().reverse().slice(0, 12);

	weekCounts = await Promise.all(
		sortedWeeks.map(async (label) => ({ label, count: (await kv.get<number>(`pv:week:${label}`)) ?? 0 }))
	);
	monthCounts = await Promise.all(
		sortedMonths.map(async (label) => ({ label, count: (await kv.get<number>(`pv:month:${label}`)) ?? 0 }))
	);
} catch (err) {
	errorMessage = 'Kon de statistieken nog niet ophalen — is de KV-database al gekoppeld in Vercel?';
	console.error('Statistiek: KV-fout', err);
}

const maxWeek = Math.max(1, ...weekCounts.map((w) => w.count));
const maxMonth = Math.max(1, ...monthCounts.map((m) => m.count));
---

<BaseLayout title="Statistiek" description="Bezoekersstatistieken." showSolasBar={false} noindex={true}>
	<div class="container page">
		<h1 class="page__title">Statistiek</h1>

		{errorMessage ? (
			<p class="contact-form__status contact-form__status--error">{errorMessage}</p>
		) : (
			<>
				<p>Totaal aantal paginaweergaves sinds de start van de teller: <strong>{total.toLocaleString('nl-NL')}</strong></p>

				<h2>Per week</h2>
				{weekCounts.length === 0 ? (
					<p>Nog geen gegevens.</p>
				) : (
					<div class="stat-chart">
						{weekCounts.slice().reverse().map((w) => (
							<div class="stat-chart__col">
								<div class="stat-chart__bararea">
									<span class="stat-chart__value">{w.count}</span>
									<span class="stat-chart__bar" style={`height: ${(w.count / maxWeek) * 100}%`} />
								</div>
								<span class="stat-chart__label">{w.label}</span>
							</div>
						))}
					</div>
				)}

				<h2>Per maand</h2>
				{monthCounts.length === 0 ? (
					<p>Nog geen gegevens.</p>
				) : (
					<div class="stat-chart">
						{monthCounts.slice().reverse().map((m) => (
							<div class="stat-chart__col">
								<div class="stat-chart__bararea">
									<span class="stat-chart__value">{m.count}</span>
									<span class="stat-chart__bar" style={`height: ${(m.count / maxMonth) * 100}%`} />
								</div>
								<span class="stat-chart__label">{m.label}</span>
							</div>
						))}
					</div>
				)}

				<p class="stat-footnote">
					Telt paginaweergaves (niet unieke bezoekers) — geen cookies, geen IP-adressen opgeslagen.
				</p>
			</>
		)}
	</div>
</BaseLayout>
