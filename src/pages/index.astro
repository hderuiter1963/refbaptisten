---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollSection from '../components/ScrollSection.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { getCollection } from 'astro:content';
import { geschiedenis, wieBepaalt } from '../data/homeSections';
import { featureCards, vooruitblik } from '../data/home';
import { getWorldNews } from '../lib/news';
import { getQuoteOfTheWeek } from '../lib/weeklyQuote';

// "Recente berichten" komt nu rechtstreeks uit de content collection
// (voorheen via een aparte WordPress-subapplicatie/widget geregeld).
const recentPosts = (await getCollection('posts'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 4);

// "Nieuw"-stempel: alleen bij berichten die nog maar kort geleden zijn
// geplaatst, zodat het vanzelf weer verdwijnt i.p.v. permanent aan het
// bovenste bericht te blijven plakken.
const NEW_BADGE_DAYS = 30;
const isNew = (date: Date) => Date.now() - date.getTime() < NEW_BADGE_DAYS * 24 * 60 * 60 * 1000;

// Reformed Baptists wereldwijd: externe RSS-feeds, opgehaald tijdens de
// build (zie src/lib/news.ts). Als alle bronnen falen, blijft dit gewoon
// leeg en tonen we de sectie niet — geen kapotte homepage door een
// onbereikbare externe site.
const worldNews = await getWorldNews();

const quoteOfTheWeek = getQuoteOfTheWeek();
---

<BaseLayout title="Home" description="Reformatorische Baptisten — geworteld in de Bijbel, gevormd door de reformatie." showSolasBar={false}>
	<section class="hero-modern">
		<div class="container">
			<p class="hero-modern__eyebrow">Reformatorische Baptisten</p>
			<h1>Geworteld in de Bijbel, gevormd door de reformatie.</h1>
			<p class="hero-modern__lead">
				Levend in het geloof dat Jezus Christus Heere is over heel het leven.
			</p>
			<ul class="solas">
				<li>Sola Scriptura</li>
				<li>Sola Gratia</li>
				<li>Sola Fide</li>
				<li>Sola Christus</li>
				<li>Soli Deo Gloria</li>
			</ul>
		</div>
	</section>

	<section class="verse-of-week">
		<div class="container">
			<blockquote class="verse-of-week__quote">
				<p>&ldquo;{quoteOfTheWeek.text}&rdquo;</p>
				<cite>&mdash; {quoteOfTheWeek.ref}</cite>
			</blockquote>
		</div>
	</section>

	<div class="container page">
		<h2>Recente berichten</h2>
		<ul class="post-tile-grid">
			{recentPosts.map((post) => (
				<li class="post-tile">
					<a href={`/${post.id}/`} class="post-tile__link" title={post.data.title}>
						{post.data.image && (
							<img class="post-tile__image" src={post.data.image} alt="" loading="lazy" />
						)}
						<span class="post-tile__body">
							<span class="post-tile__title">
								{post.data.title}
								{isNew(post.data.date) && <span class="badge-new">Nieuw</span>}
							</span>
							<time class="post-tile__date" datetime={post.data.date.toISOString()}>
								{post.data.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}
							</time>
						</span>
					</a>
				</li>
			))}
		</ul>
		<p><a href="/berichten/" class="link-arrow">Alle berichten &rarr;</a></p>

		<h2>Vooruitblik</h2>
		<ul class="vooruitblik-list">
			{vooruitblik.map((item) => (
				<li><strong>{item.title}</strong>, {item.text}</li>
			))}
		</ul>
	</div>

	{worldNews.length > 0 && (
		<section class="world-news">
			<div class="container">
				<h2>Reformed Baptists wereldwijd</h2>
				<p class="world-news__intro">
					Nieuws en artikelen van reformed-baptistische stemmen elders in de wereld.
				</p>
				<ul class="world-news__list">
					{worldNews.map((item) => (
						<li class="world-news__item">
							<span class="world-news__source">{item.sourceName}</span>
							<a href={item.link} target="_blank" rel="noopener noreferrer" class="world-news__title">
								{item.title}
							</a>
							{item.snippet && <p class="world-news__snippet">{item.snippet}</p>}
							{item.date && (
								<time class="world-news__date" datetime={item.date.toISOString()}>
									{item.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}
								</time>
							)}
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<section class="scroll-section-pair">
		<div class="container scroll-section-pair__grid">
			<ScrollSection items={geschiedenis} />
			<ScrollSection items={wieBepaalt} />
		</div>
	</section>

	<div class="container page">
		<ul class="card-grid card-grid--large">
			{featureCards.map((card) => (
				<li class="card">
					<img src={card.image} alt={card.alt} loading="lazy" />
					<h3>{card.title}</h3>
					<p>{card.text}</p>
				</li>
			))}
		</ul>
	</div>

	<AuthorBio />
</BaseLayout>
