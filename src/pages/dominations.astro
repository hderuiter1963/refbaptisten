---
// Verborgen pagina: niet in het menu, niet in zoekmachines (noindex, robots.txt,
// niet in de sitemap), alleen bereikbaar via /dominations/.
// Interactieve verkenner voor DomiNations-statistieken (Councilors en Artifacts),
// gedownload van dominations.fandom.com (CC-BY-SA) en opgeslagen in
// src/data/dominations.json. Volledig statisch: filteren en sorteren gebeurt in de browser.
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/dominations.json';
---

<BaseLayout title="DomiNations" description="DomiNations-statistieken." showSolasBar={false} noindex={true}>
	<div class="container page dn">
		<h1 class="page__title">DomiNations: Councilors &amp; Artifacts</h1>
		<p class="stat-footnote">
			Bron: dominations.fandom.com (CC-BY-SA), opgehaald op {data.fetched}. Amelia Earhart (alleen War, Legendary) is handmatig toegevoegd omdat de wiki haar nog mist. Alleen Legendary en Mythical artifacts hebben vaste stats;
			gewone artifacts hebben willekeurige benefits. De indeling in aanval/verdediging/economie is een trefwoord-benadering.
		</p>

		<div class="dn-tabs" role="tablist">
			<button class="dn-tab is-active" data-tab="c" role="tab">Councilors</button>
			<button class="dn-tab" data-tab="a" role="tab">Artifacts</button>
			<button class="dn-tab" data-tab="m" role="tab">Mijn collectie</button>
		</div>

		<section id="dn-c">
			<div class="dn-filters">
				<input type="search" id="c-q" placeholder="Zoek councilor of benefit…" />
				<select id="c-chamber"><option value="">Alle chambers</option><option>Primary</option><option>War</option></select>
				<select id="c-domain"><option value="">Alle soorten</option><option>Offense</option><option>Defense</option><option>Economy</option><option>Other</option></select>
			</div>
			<div class="dn-tiles" id="c-tiles"></div>
			<div class="dn-grid">
				<div><h2>Gemiddelde waarde per zeldzaamheid</h2><div class="dn-bars" id="c-rarity"></div></div>
				<div><h2>Meest voorkomende benefits</h2><div class="dn-hbars" id="c-top"></div></div>
			</div>
			<h2>Benefits per councilor <small id="c-count"></small></h2>
			<div class="dn-tablewrap"><table class="dn-table" id="c-table"></table></div>
		</section>

		<section id="dn-a" hidden>
			<div class="dn-filters">
				<input type="search" id="a-q" placeholder="Zoek artifact of benefit…" />
				<select id="a-klass"><option value="">Alle klassen</option><option>Legendary</option><option>Legendary War</option><option>Mythical</option><option>Mythical War</option></select>
				<select id="a-domain"><option value="">Alle soorten</option><option>Offense</option><option>Defense</option><option>Economy</option><option>Other</option></select>
			</div>
			<div class="dn-tiles" id="a-tiles"></div>
			<div class="dn-grid">
				<div><h2>Gemiddelde stat per klasse</h2><div class="dn-bars" id="a-klassbars"></div></div>
				<div><h2>Meest voorkomende benefits</h2><div class="dn-hbars" id="a-top"></div></div>
			</div>
			<h2>Artifacts <small id="a-count"></small></h2>
			<p class="stat-footnote">Klik op een rij voor de benefits. Totaal = som van de absolute stat-waarden.</p>
			<div class="dn-tablewrap"><table class="dn-table" id="a-table"></table></div>
		</section>

		<section id="dn-m" hidden>
			<p class="stat-footnote">Je invoer blijft alleen in deze browser bewaard (localStorage), niet op de server. De stats zijn basiswaarden van de wiki (zonder levels).</p>
			<div class="dn-filters">
				<label>Focus <select id="m-focus"><option value="">Alles</option><option>Offense</option><option>Defense</option><option>Economy</option></select></label>
				<button class="dn-btn" id="m-export">Exporteer</button>
				<button class="dn-btn" id="m-import">Importeer</button>
				<button class="dn-btn" id="m-clear">Alles wissen</button>
			</div>
			<div class="dn-filters dn-lim">
				<span>Live slots (0 = onbeperkt):</span>
				<label>Councilors Primary <input type="number" min="0" id="lim-cP" /></label>
				<label>Councilors War <input type="number" min="0" id="lim-cW" /></label>
				<label>Artifacts main <input type="number" min="0" id="lim-aM" /></label>
				<label>Artifacts war <input type="number" min="0" id="lim-aW" /></label>
			</div>
			<div class="dn-grid">
				<div>
					<h2>Mijn councilors</h2>
					<div class="dn-filters">
						<select id="mc-name"></select>
						<select id="mc-rar"></select>
						<select id="mc-ch"><option>Primary</option><option>War</option></select>
						<button class="dn-btn dn-btn--p" id="mc-add">Toevoegen</button>
					</div>
					<div id="mc-list"></div>
				</div>
				<div>
					<h2>Mijn artifacts</h2>
					<div class="dn-filters">
						<select id="ma-name"></select>
						<button class="dn-btn dn-btn--p" id="ma-add">Toevoegen</button>
					</div>
					<div id="ma-list"></div>
				</div>
			</div>
			<div class="dn-tiles" id="m-tiles"></div>
			<h2>Mijn totalen per benefit</h2>
			<div class="dn-tablewrap"><table class="dn-table" id="m-totals"></table></div>
			<h2>Verbeteradvies</h2>
			<div class="dn-grid" id="m-advice"></div>
		</section>

		<script id="dn-data" type="application/json" set:html={JSON.stringify(data)} />
	</div>
</BaseLayout>

<script>
	const D = JSON.parse(document.getElementById('dn-data')!.textContent!);
	const RAR = ['Common', 'Uncommon', 'Rare', 'Epic', 'Legendary'];
	const $ = (id: string) => document.getElementById(id) as any;
	const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	const fmt = (v: number) => (v > 0 ? '+' : '') + v + '%';
	const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : 0);
	const r1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('nl-NL');

	const tiles = (el: string, items: [string, string][]) =>
		($(el).innerHTML = items.map(([l, v]) => `<div class="dn-tile"><b>${v}</b><span>${l}</span></div>`).join(''));
	const bars = (el: string, items: [string, number][]) => {
		const max = Math.max(1, ...items.map((i) => i[1]));
		$(el).innerHTML = items
			.map(([l, v]) => `<div class="dn-col"><span class="dn-val">${r1(v)}</span><div class="dn-bararea"><i style="height:${(v / max) * 100}%"></i></div><span class="dn-lab">${esc(l)}</span></div>`)
			.join('');
	};
	const hbars = (el: string, items: [string, number][]) => {
		const max = Math.max(1, ...items.map((i) => i[1]));
		$(el).innerHTML = items
			.map(([l, v]) => `<div class="dn-row"><span class="dn-rl">${esc(l)}</span><span class="dn-track"><i style="width:${(v / max) * 100}%"></i></span><span class="dn-rv">${v}</span></div>`)
			.join('');
	};
	const topCounts = (names: string[], n = 10): [string, number][] => {
		const m = new Map<string, number>();
		names.forEach((x) => m.set(x, (m.get(x) ?? 0) + 1));
		return [...m].sort((a, b) => b[1] - a[1]).slice(0, n);
	};

	// Sorteerbare tabel: cols = [label, sortWaarde(rij), weergave(rij)]
	function table(el: string, cols: any[], rows: any[], state: { k: number; d: number }, onRow?: (r: any) => string) {
		const sorted = rows.slice().sort((x, y) => {
			const a = cols[state.k][1](x), b = cols[state.k][1](y);
			return (typeof a === 'string' ? a.localeCompare(b, 'nl') : (a ?? -1e9) - (b ?? -1e9)) * state.d;
		});
		$(el).innerHTML =
			`<thead><tr>${cols.map((c, i) => `<th data-k="${i}" class="${i === state.k ? (state.d > 0 ? 'asc' : 'desc') : ''}">${c[0]}</th>`).join('')}</tr></thead><tbody>` +
			sorted.slice(0, 400).map((r) => `<tr${onRow ? ' class="dn-click"' : ''} data-id="${esc(String(r.id ?? ''))}">${cols.map((c) => `<td>${c[2](r)}</td>`).join('')}</tr>${onRow ? `<tr class="dn-detail" hidden><td colspan="${cols.length}">${onRow(r)}</td></tr>` : ''}`).join('') +
			'</tbody>';
		$(el).querySelectorAll('th').forEach((th: HTMLElement) =>
			th.addEventListener('click', () => {
				const k = +th.dataset.k!;
				state.d = state.k === k ? -state.d : k === 0 ? 1 : -1;
				state.k = k;
				table(el, cols, rows, state, onRow);
			}));
		if (onRow) $(el).querySelectorAll('tr.dn-click').forEach((tr: HTMLElement) => tr.addEventListener('click', () => ((tr.nextElementSibling as HTMLElement).hidden = !(tr.nextElementSibling as HTMLElement).hidden)));
	}

	// ---------- Councilors ----------
	const C = D.councilors.map(([n, ch, b, dom, rar, v]: any[]) => ({ n, ch, b, dom, rar, v }));
	const cRows = new Map<string, any>();
	C.forEach((r: any) => {
		const key = `${r.n}|${r.ch}|${r.b}`;
		if (!cRows.has(key)) cRows.set(key, { id: key, n: r.n, ch: r.ch, b: r.b, dom: r.dom, vals: {} });
		cRows.get(key).vals[r.rar] = r.v;
	});
	const cAll = [...cRows.values()];
	const cState = { k: 0, d: 1 };
	function renderC() {
		const q = $('c-q').value.toLowerCase(), ch = $('c-chamber').value, dom = $('c-domain').value;
		const rows = cAll.filter((r) => (!ch || r.ch === ch) && (!dom || r.dom === dom) && (!q || (r.n + ' ' + r.b).toLowerCase().includes(q)));
		const leg = rows.filter((r) => r.vals.Legendary != null);
		tiles('c-tiles', [
			['councilors', String(new Set(rows.map((r) => r.n)).size)],
			['benefits (rijen)', String(rows.length)],
			['gem. Legendary', r1(mean(leg.map((r) => Math.abs(r.vals.Legendary)))) + '%'],
			['hoogste Legendary', leg.length ? r1(Math.max(...leg.map((r) => Math.abs(r.vals.Legendary)))) + '%' : '–'],
		]);
		bars('c-rarity', RAR.map((x) => [x, mean(rows.filter((r) => r.vals[x] != null).map((r) => Math.abs(r.vals[x])))]));
		hbars('c-top', topCounts(leg.map((r) => r.b)));
		$('c-count').textContent = `(${rows.length})`;
		table('c-table', [
			['Councilor', (r: any) => r.n, (r: any) => esc(r.n)],
			['Chamber', (r: any) => r.ch, (r: any) => r.ch],
			['Benefit', (r: any) => r.b, (r: any) => esc(r.b)],
			['Soort', (r: any) => r.dom, (r: any) => r.dom],
			...RAR.map((x) => [x, (r: any) => (r.vals[x] == null ? null : Math.abs(r.vals[x])), (r: any) => (r.vals[x] == null ? '' : fmt(r.vals[x]))]),
		], rows, cState);
	}
	['c-q', 'c-chamber', 'c-domain'].forEach((id) => $(id).addEventListener('input', renderC));

	// ---------- Artifacts ----------
	const A = new Map<string, any>();
	D.artifacts.forEach(([n, k, b, dom, st, v]: any[]) => {
		const key = `${n}|${k}`;
		if (!A.has(key)) A.set(key, { id: key, n, k, items: [] });
		A.get(key).items.push({ b, dom, st, v });
	});
	const aAll = [...A.values()];
	const aState = { k: 0, d: 1 };
	function renderA() {
		const q = $('a-q').value.toLowerCase(), kl = $('a-klass').value, dom = $('a-domain').value;
		const rows = aAll
			.filter((a) => !kl || a.k === kl)
			.map((a) => {
				const items = a.items.filter((i: any) => (!dom || i.dom === dom) && (!q || (a.n + ' ' + i.b).toLowerCase().includes(q)));
				return { ...a, items, count: items.length, total: items.reduce((s: number, i: any) => s + Math.abs(i.v), 0) };
			})
			.filter((a) => a.count > 0);
		const all = rows.flatMap((a) => a.items);
		tiles('a-tiles', [
			['artifacts', String(rows.length)],
			['benefit-rijen', String(all.length)],
			['gem. stat', r1(mean(all.map((i) => Math.abs(i.v)))) + '%'],
			['gem. totaal/artifact', r1(mean(rows.map((a) => a.total)))],
		]);
		bars('a-klassbars', ['Legendary', 'Legendary War', 'Mythical', 'Mythical War'].map((k) => [k, mean(rows.filter((a) => a.k === k).flatMap((a) => a.items).map((i: any) => Math.abs(i.v)))]));
		hbars('a-top', topCounts(all.map((i) => i.b)));
		$('a-count').textContent = `(${rows.length})`;
		table('a-table', [
			['Artifact', (a: any) => a.n, (a: any) => esc(a.n)],
			['Klasse', (a: any) => a.k, (a: any) => a.k],
			['Benefits', (a: any) => a.count, (a: any) => a.count],
			['Totaal', (a: any) => a.total, (a: any) => a.total],
		], rows, aState, (a: any) => a.items.map((i: any) => `${esc(i.b)} <b>${fmt(i.v)}</b>`).join(' · '));
	}
	['a-q', 'a-klass', 'a-domain'].forEach((id) => $(id).addEventListener('input', renderA));

	// ---------- Mijn collectie ----------
	type Mine = { c: { n: string; rar: string; ch: string; off?: boolean }[]; a: string[]; aOff?: string[]; lim?: Record<string, number> };
	const KEY = 'dn-mine';
	const loadMine = (): Mine => {
		try { const m = JSON.parse(localStorage.getItem(KEY) || ''); if (m && Array.isArray(m.c) && Array.isArray(m.a)) return m; } catch {}
		return { c: [], a: [] };
	};
	let mine: Mine = loadMine();
	const saveMine = () => { try { localStorage.setItem(KEY, JSON.stringify(mine)); } catch {} renderM(); };
	const cNames = [...new Set<string>(C.map((r: any) => r.n))].sort((x, y) => x.localeCompare(y, 'nl'));
	$('mc-name').innerHTML = cNames.map((n) => `<option>${esc(n)}</option>`).join('');
	$('mc-rar').innerHTML = RAR.map((r) => `<option${r === 'Legendary' ? ' selected' : ''}>${r}</option>`).join('');
	$('ma-name').innerHTML = aAll.slice().sort((x, y) => x.n.localeCompare(y.n, 'nl') || x.k.localeCompare(y.k)).map((a) => `<option value="${esc(a.id)}">${esc(a.n)} (${a.k})</option>`).join('');
	const sumAbs = (xs: any[]) => xs.reduce((s: number, x: any) => s + Math.abs(x.v), 0);
	// Benefits van een councilor bij een rarity: alleen waarden die op die rarity al bestaan.
	const cBenefits = (n: string, ch: string, rar: string) => C.filter((r: any) => r.n === n && r.ch === ch && r.rar === rar);
	const inFocus = (dom: string) => !$('m-focus').value || dom === $('m-focus').value;
	const btnRm = (kind: string, i: number) => `<button class="dn-btn" data-rm="${kind}" data-i="${i}" title="Verwijder">✕</button>`;

	function renderM() {
		const tot = new Map<string, { dom: string; c: number; a: number }>();
		const add = (b: string, dom: string, key: 'c' | 'a', v: number) => {
			if (!tot.has(b)) tot.set(b, { dom, c: 0, a: 0 });
			tot.get(b)![key] += v;
		};
		$('mc-list').innerHTML = mine.c.length ? mine.c.map((m, i) => {
			const bs = cBenefits(m.n, m.ch, m.rar);
			if (!m.off) bs.forEach((r: any) => add(r.b, r.dom, 'c', r.v));
			const ri = RAR.indexOf(m.rar), next = ri < 4 ? sumAbs(cBenefits(m.n, m.ch, RAR[ri + 1])) - sumAbs(bs) : 0;
			return `<div class="dn-own${m.off ? ' dn-own--off' : ''}"><div><label class="dn-on"><input type="checkbox" data-on="c" data-i="${i}"${m.off ? '' : ' checked'} /> Live</label> <b>${esc(m.n)}</b> · ${m.rar} · ${m.ch} ${btnRm('c', i)}</div><div class="dn-own__b">${bs.length ? bs.map((r: any) => `${esc(r.b)} <b>${fmt(r.v)}</b>`).join(' · ') : 'Geen benefits op deze zeldzaamheid/chamber'}${next > 0 ? `<br><em>Volgende rarity: +${r1(next)} stat-punten</em>` : ''}</div></div>`;
		}).join('') : '<p class="stat-footnote">Nog geen councilors toegevoegd.</p>';
		const mineA = mine.a.map((id) => A.get(id)).filter(Boolean);
		const aOff = new Set(mine.aOff ?? []);
		$('ma-list').innerHTML = mineA.length ? mineA.map((a: any, i: number) => {
			if (!aOff.has(a.id)) a.items.forEach((x: any) => add(x.b, x.dom, 'a', x.v));
			return `<div class="dn-own${aOff.has(a.id) ? ' dn-own--off' : ''}"><div><label class="dn-on"><input type="checkbox" data-on="a" data-i="${i}"${aOff.has(a.id) ? '' : ' checked'} /> Live</label> <b>${esc(a.n)}</b> · ${a.k} · totaal ${sumAbs(a.items)} ${btnRm('a', i)}</div><div class="dn-own__b">${a.items.map((x: any) => `${esc(x.b)} <b>${fmt(x.v)}</b>`).join(' · ')}</div></div>`;
		}).join('') : '<p class="stat-footnote">Nog geen artifacts toegevoegd.</p>';

		const rows = [...tot].map(([b, o]) => ({ id: b, b, dom: o.dom, c: o.c, a: o.a, t: o.c + o.a })).filter((r) => inFocus(r.dom));
		const dom = (d: string) => rows.filter((r) => r.dom === d).reduce((s, r) => s + Math.abs(r.t), 0);
		const lim = mine.lim ?? {};
		const cnt = (n: number, l: number) => `${n}${l ? '/' + l : ''}`;
		const cP = mine.c.filter((m) => !m.off && m.ch === 'Primary').length, cW = mine.c.filter((m) => !m.off && m.ch === 'War').length;
		const liveA = mineA.filter((a: any) => !aOff.has(a.id)), aW = liveA.filter((a: any) => a.k.includes('War')).length, aM = liveA.length - aW;
		const over = (n: number, l: number) => (l && n > l ? ' ⚠' : '');
		tiles('m-tiles', [['Primary live', cnt(cP, lim.cP) + over(cP, lim.cP)], ['War live', cnt(cW, lim.cW) + over(cW, lim.cW)], ['artifacts main live', cnt(aM, lim.aM) + over(aM, lim.aM)], ['artifacts war live', cnt(aW, lim.aW) + over(aW, lim.aW)], ['aanval', r1(dom('Offense'))], ['verdediging', r1(dom('Defense'))], ['economie', r1(dom('Economy'))]]);
		table('m-totals', [
			['Benefit', (r: any) => r.b, (r: any) => esc(r.b)],
			['Soort', (r: any) => r.dom, (r: any) => r.dom],
			['Councilors', (r: any) => Math.abs(r.c), (r: any) => (r.c ? fmt(r.c) : '')],
			['Artifacts', (r: any) => Math.abs(r.a), (r: any) => (r.a ? fmt(r.a) : '')],
			['Totaal', (r: any) => Math.abs(r.t), (r: any) => `<b>${fmt(r.t)}</b>`],
		], rows, mState);

		// Adviezen
		const adv: string[] = [];
		const list = (title: string, items: string[], note = '') => adv.push(`<div><h3>${title}</h3>${note ? `<p class="stat-footnote">${note}</p>` : ''}${items.length ? '<ol>' + items.map((x) => `<li>${x}</li>`).join('') + '</ol>' : '<p class="stat-footnote">Niets te adviseren.</p>'}</div>`);
		const ups = mine.c.map((m) => {
			const ri = RAR.indexOf(m.rar); if (ri >= 4) return null;
			const f = (rar: string) => sumAbs(cBenefits(m.n, m.ch, rar).filter((r: any) => inFocus(r.dom)));
			return { m, gain: f(RAR[ri + 1]) - f(m.rar) };
		}).filter((x: any) => x && x.gain > 0).sort((x: any, y: any) => y.gain - x.gain).slice(0, 6) as any[];
		list('Councilors upgraden', ups.map((u) => `<b>${esc(u.m.n)}</b> ${u.m.rar} → ${RAR[RAR.indexOf(u.m.rar) + 1]}: +${r1(u.gain)}`), 'Winst in stat-punten (binnen je focus).');
		const owned = new Set(mine.c.map((m) => m.n));
		const best = cNames.filter((n) => !owned.has(n)).map((n) => {
			const per = ['Primary', 'War'].map((ch) => ({ ch, v: sumAbs(C.filter((r: any) => r.n === n && r.ch === ch && r.rar === 'Legendary' && inFocus(r.dom))) }));
			return per.sort((x, y) => y.v - x.v)[0] && { n, ...per.sort((x, y) => y.v - x.v)[0] };
		}).filter((x: any) => x && x.v > 0).sort((x: any, y: any) => y.v - x.v).slice(0, 6) as any[];
		list('Councilors om te zoeken (Legendary)', best.map((x) => `<b>${esc(x.n)}</b> in ${x.ch}-chamber: ${r1(x.v)}`), 'Je hebt ze nog niet; getoond is de beste chamber.');
		const mUp = mineA.map((a: any) => {
			const to = a.k.replace('Legendary', 'Mythical'), m2 = a.k.startsWith('Legendary') ? A.get(`${a.n}|${to}`) : null;
			if (!m2) return null;
			const f = (x: any) => sumAbs(x.items.filter((i: any) => inFocus(i.dom)));
			return { a, gain: f(m2) - f(a) };
		}).filter((x: any) => x && x.gain > 0).sort((x: any, y: any) => y.gain - x.gain).slice(0, 6) as any[];
		list('Artifacts naar Mythical', mUp.map((u) => `<b>${esc(u.a.n)}</b> (${u.a.k}): +${r1(u.gain)}`), 'Beschikbare Mythical-variant van een artifact dat je al hebt.');
		const ownedA = new Set(mine.a);
		const bestA = aAll.filter((a) => !ownedA.has(a.id)).map((a) => ({ a, v: sumAbs(a.items.filter((i: any) => inFocus(i.dom))) })).filter((x) => x.v > 0).sort((x, y) => y.v - x.v).slice(0, 6);
		list('Sterkste artifacts die je mist', bestA.map((x) => `<b>${esc(x.a.n)}</b> (${x.a.k}): ${r1(x.v)}`));
		const sleeping = [
			...mine.c.filter((m) => m.off).map((m) => ({ t: `${esc(m.n)} (${m.ch}, ${m.rar})`, v: sumAbs(cBenefits(m.n, m.ch, m.rar).filter((r: any) => inFocus(r.dom))) })),
			...mineA.filter((a: any) => aOff.has(a.id)).map((a: any) => ({ t: `${esc(a.n)} (${a.k})`, v: sumAbs(a.items.filter((i: any) => inFocus(i.dom))) })),
		].filter((x) => x.v > 0).sort((x, y) => y.v - x.v).slice(0, 6);
		list('Niet live maar sterk', sleeping.map((x) => `<b>${x.t}</b>: ${r1(x.v)}`), 'Overweeg deze live te zetten als je slots het toelaten.');
		$('m-advice').innerHTML = adv.join('');
		$('mc-list').querySelectorAll('[data-rm]').forEach((b: HTMLElement) => b.addEventListener('click', () => { mine.c.splice(+b.dataset.i!, 1); saveMine(); }));
		document.querySelectorAll('#dn-m input[data-on]').forEach((b: any) => b.addEventListener('change', () => {
			const i = +b.dataset.i;
			if (b.dataset.on === 'c') mine.c[i].off = !b.checked;
			else { const id = mine.a[i], o = new Set(mine.aOff ?? []); b.checked ? o.delete(id) : o.add(id); mine.aOff = [...o]; }
			saveMine();
		}));
		$('ma-list').querySelectorAll('[data-rm]').forEach((b: HTMLElement) => b.addEventListener('click', () => { mine.a.splice(+b.dataset.i!, 1); saveMine(); }));
	}
	const mState = { k: 4, d: -1 };
	$('mc-add').addEventListener('click', () => { mine.c.push({ n: $('mc-name').value, rar: $('mc-rar').value, ch: $('mc-ch').value }); saveMine(); });
	$('ma-add').addEventListener('click', () => { if (!mine.a.includes($('ma-name').value)) mine.a.push($('ma-name').value); saveMine(); });
	['cP', 'cW', 'aM', 'aW'].forEach((k) => {
		$('lim-' + k).value = mine.lim?.[k] || '';
		$('lim-' + k).addEventListener('input', () => { mine.lim = { ...(mine.lim ?? {}), [k]: Math.max(0, +$('lim-' + k).value || 0) }; saveMine(); });
	});
	$('m-focus').addEventListener('input', renderM);
	$('m-clear').addEventListener('click', () => { if (confirm('Je hele collectie wissen?')) { mine = { c: [], a: [] }; ['cP', 'cW', 'aM', 'aW'].forEach((k) => ($('lim-' + k).value = '')); saveMine(); } });
	$('m-export').addEventListener('click', () => prompt('Kopieer deze tekst om je collectie te bewaren:', JSON.stringify(mine)));
	$('m-import').addEventListener('click', () => {
		const t = prompt('Plak eerder geëxporteerde collectie-tekst:');
		if (!t) return;
		try { const m = JSON.parse(t); if (Array.isArray(m.c) && Array.isArray(m.a)) { mine = m; ['cP', 'cW', 'aM', 'aW'].forEach((k) => ($('lim-' + k).value = m.lim?.[k] || '')); saveMine(); } else throw 0; } catch { alert('Ongeldige tekst.'); }
	});

	document.querySelectorAll('.dn-tab').forEach((t: any) =>
		t.addEventListener('click', () => {
			document.querySelectorAll('.dn-tab').forEach((x) => x.classList.toggle('is-active', x === t));
			$('dn-c').hidden = t.dataset.tab !== 'c';
			$('dn-a').hidden = t.dataset.tab !== 'a';
			$('dn-m').hidden = t.dataset.tab !== 'm';
		}));
	renderC();
	renderA();
	renderM();
</script>

