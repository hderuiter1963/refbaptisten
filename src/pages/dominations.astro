	.dn-table th.asc::after { content: ' ▲'; font-size: 0.65rem; }
	.dn-table th.desc::after { content: ' ▼'; font-size: 0.65rem; }
	.dn-table td { padding: 0.4rem 0.7rem; border-bottom: 1px solid var(--color-border); font-variant-numeric: tabular-nums; vertical-align: top; }
	.dn-table td input[type='checkbox'] { width: 1.1rem; height: 1.1rem; cursor: pointer; }
	.dn-table td select { font: inherit; font-size: 0.8rem; padding: 0.15rem 0.3rem; }
	.dn-owned td { background: color-mix(in srgb, var(--color-primary) 7%, transparent); }
	.dn-ben { display: inline-block; margin: 0 0.9rem 0.15rem 0; color: var(--color-muted); white-space: nowrap; }
	.dn-ben b { color: var(--color-text); }
	.dn-num { width: 3.6rem; font: inherit; font-size: 0.8rem; padding: 0.1rem 0.25rem; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-bg); color: var(--color-text); }
	.dn-ov { color: var(--color-accent) !important; border-color: var(--color-accent); }
</style>
