---
// Verborgen pagina: niet in het menu, niet in zoekmachines (noindex, robots.txt,
// niet in de sitemap), alleen bereikbaar via /dominations/.
// Lijst van alle DomiNations-Councilors (Epic/Legendary) en -Artifacts (Legendary/Mythical),
// gedownload van dominations.fandom.com (CC-BY-SA) en opgeslagen in
// src/data/dominations.json. Per item vink je "in bezit" en "live" aan; de collectie
// wordt lokaal bewaard en (na inloggen) op de server via /api/dominations/.
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/dominations.json';
---

<BaseLayout title="DomiNations" description="DomiNations-statistieken." showSolasBar={false} noindex={true}>
	<div class="container page dn">
		<h1 class="page__title">DomiNations: Councilors &amp; Artifacts</h1>
		<p class="stat-footnote">
			Bron: dominations.fandom.com (CC-BY-SA), opgehaald op {data.fetched}. Amelia Earhart (alleen War, Legendary) en Galileo Galilei (alleen Primary, Epic) zijn handmatig toegevoegd omdat de wiki ze nog mist.
			Alleen Legendary en Mythical artifacts hebben vaste stats. Councilor-stats zijn basiswaarden (zonder levels); bij artifacts is 9 punten bij de wiki-waarden opgeteld. Klopt een percentage niet meer? Zet "Waarden bewerken" aan: je kunt dan percentages en namen aanpassen, benefits verwijderen of toevoegen, en Primary en War van een councilor wisselen. Alles wordt bij je collectie bewaard. De indeling in aanval/verdediging/economie is een trefwoord-benadering.
		</p>

		<div class="dn-box">
			<div class="dn-filters dn-login">
				<input type="password" id="m-pw" placeholder="Wachtwoord" autocomplete="current-password" />
				<button class="dn-btn dn-btn--p" id="m-login">Inloggen</button>
				<button class="dn-btn" id="m-logout" hidden>Uitloggen</button>
				<span id="m-status" class="stat-footnote">Niet ingelogd: alleen in deze browser opgeslagen.</span>
			</div>
			<div class="dn-filters dn-lim">
				<label>Focus <select id="m-focus"><option value="">Alles</option><option>Offense</option><option>Defense</option><option>Economy</option></select></label>
				<span>Live slots (0 = onbeperkt):</span>
				<label>Councilors Primary <input type="number" min="0" id="lim-cP" /></label>
				<label>Councilors War <input type="number" min="0" id="lim-cW" /></label>
				<label>Artifacts main <input type="number" min="0" id="lim-aM" /></label>
				<label>Artifacts war <input type="number" min="0" id="lim-aW" /></label>
				<button class="dn-btn" id="m-edit">Waarden bewerken</button>
				<button class="dn-btn" id="m-ovreset" hidden>Reset aanpassingen</button>
				<button class="dn-btn" id="m-export">Exporteer</button>
				<button class="dn-btn" id="m-import">Importeer</button>
				<button class="dn-btn" id="m-clear">Alles wissen</button>
			</div>
		</div>

		<div class="dn-tabs" role="tablist">
			<button class="dn-tab is-active" data-tab="c" role="tab">Councilors</button>
			<button class="dn-tab" data-tab="a" role="tab">Artifacts</button>
		</div>

		<section id="dn-c">
			<div class="dn-filters">
				<input type="search" id="c-q" placeholder="Zoek councilor of benefit…" />
				<div class="dn-seg" id="c-view" role="group" aria-label="Chamber">
					<button data-v="Primary" class="is-active">Primary</button><button data-v="War">War</button>
				</div>
				<select id="c-own"><option value="">Alle</option><option value="own">In bezit</option><option value="miss">Niet in bezit</option></select>
				<select id="c-type"><option value="">Alle typen</option></select>
			</div>
			<p class="stat-footnote">De chamber-knop bepaalt welke benefits en scores je ziet. Primary en War zijn aparte kaarten: wat je ziet (bezit, zeldzaamheid, live) hoort bij de gekozen chamber. Heb je de councilor in beide chambers, schakel dan om en vink hem daar ook aan. Klik op een kolomkop om te sorteren.</p>
			<div class="dn-tiles" id="c-tiles"></div>
			<div class="dn-tablewrap"><table class="dn-table" id="c-table"></table></div>
		</section>

		<section id="dn-a" hidden>
			<div class="dn-filters">
				<input type="search" id="a-q" placeholder="Zoek artifact of benefit…" />
				<select id="a-exh"><option value="">Main + War</option><option value="Main">Main exhibit</option><option value="War">War exhibit</option></select>
				<select id="a-klass"><option value="">Alle klassen</option><option>Legendary</option><option>Legendary War</option><option>Mythical</option><option>Mythical War</option></select>
				<select id="a-own"><option value="">Alle</option><option value="own">In bezit</option><option value="miss">Niet in bezit</option></select>
			</div>
			<div class="dn-filters" id="a-add" hidden>
				<input type="text" id="a-add-n" placeholder="Naam van nieuw artifact" maxlength="60" />
				<select id="a-add-k"><option>Legendary</option><option>Legendary War</option><option>Mythical</option><option>Mythical War</option></select>
				<button class="dn-btn dn-btn--p" id="a-add-btn">+ artifact toevoegen</button>
			</div>
			<div class="dn-tiles" id="a-tiles"></div>
			<div class="dn-tablewrap"><table class="dn-table" id="a-table"></table></div>
		</section>

		<h2>Mijn stats (live items)</h2>
		<div class="dn-tiles" id="m-tiles"></div>
		<div class="dn-tablewrap"><table class="dn-table" id="m-totals"></table></div>
		<h2>Verbeteradvies</h2>
		<div class="dn-grid" id="m-advice"></div>

		<script id="dn-data" type="application/json" set:html={JSON.stringify(data)} />
	</div>
</BaseLayout>

<script>
	const D = JSON.parse(document.getElementById('dn-data')!.textContent!);
	const RAR = ['Epic', 'Legendary'];
	const $ = (id: string) => document.getElementById(id) as any;
	const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	const fmt = (v: number) => (v > 0 ? '+' : '') + v + '%';
	const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : 0);
	const r1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('nl-NL');
	const sumAbs = (xs: any[]) => xs.reduce((s: number, x: any) => s + Math.abs(x.v ?? 0), 0);
	const tiles = (el: string, items: [string, string][]) =>
		($(el).innerHTML = items.map(([l, v]) => `<div class="dn-tile"><b>${v}</b><span>${l}</span></div>`).join(''));
	const inFocus = (dom: string) => !$('m-focus').value || dom === $('m-focus').value;

	// Sorteerbare tabel: cols = [label, sortWaarde(rij), weergave(rij)]
	function table(el: string, cols: any[], rows: any[], state: { k: number; d: number }) {
		const sorted = rows.slice().sort((x, y) => {
			const a = cols[state.k][1](x), b = cols[state.k][1](y);
			return (typeof a === 'string' ? a.localeCompare(b, 'nl') : (a ?? -1e9) - (b ?? -1e9)) * state.d;
		});
		const wrap = $(el).parentElement, top = wrap.scrollTop;
		$(el).innerHTML =
			`<thead><tr>${cols.map((c, i) => `<th data-k="${i}" class="${i === state.k ? (state.d > 0 ? 'asc' : 'desc') : ''}">${c[0]}</th>`).join('')}</tr></thead><tbody>` +
			sorted.map((r) => `<tr class="${r.own ? 'dn-owned' : ''}">${cols.map((c) => `<td>${c[2](r)}</td>`).join('')}</tr>`).join('') +
			'</tbody>';
		wrap.scrollTop = top;
		$(el).querySelectorAll('th').forEach((th: HTMLElement) =>
			th.addEventListener('click', () => {
				const k = +th.dataset.k!;
				const first = rows.length ? cols[k][1](rows[0]) : '';
				state.d = state.k === k ? -state.d : typeof first === 'string' ? 1 : -1;
				state.k = k;
				table(el, cols, rows, state);
			}));
	}

	// ---------- Data ----------
	const C = D.councilors.filter((r: any[]) => RAR.includes(r[4])).map(([n, ch, b, dom, rar, v]: any[]) => ({ n, ch, b, dom, rar, v }));
	const TYPES: Record<string, string> = D.types;
	const cNames = [...new Set<string>(C.map((r: any) => r.n))].sort((x, y) => x.localeCompare(y, 'nl'));
	// councilor|chamber -> benefits met Epic- en Legendary-waarde
	const CB = new Map<string, Map<string, any>>();
	C.forEach((r: any) => {
		const k = `${r.n}|${r.ch}`;
		if (!CB.has(k)) CB.set(k, new Map());
		const m = CB.get(k)!;
		// Dezelfde benefit kan meerdere keren voorkomen (aparte slots): neem de eerste entry
		// waar deze zeldzaamheid nog leeg is, anders een nieuwe.
		let e = [...m.values()].find((x) => x.b === r.b && x[r.rar] == null);
		if (!e) { e = { b: r.b, dom: r.dom, i: m.size, ch: r.ch, Epic: null, Legendary: null }; m.set(`${r.b}#${m.size}`, e); }
		e[r.rar] = r.v;
	});
	CB.forEach((m) => m.forEach((e) => { e.E0 = e.Epic; e.L0 = e.Legendary; }));
	// Soort (aanval/verdediging/economie) op basis van trefwoorden, voor zelf toegevoegde of hernoemde benefits.
	const domainOf = (b: string) => {
		const x = b.toLowerCase(), has = (ks: string[]) => ks.some((k) => x.includes(k));
		if (has(['oil', 'gold', 'food', 'resource', 'loot', 'vault', 'storage', 'production', 'citizen', 'farm', 'mine', 'forest', 'refund', 'library', 'research', 'upgrade', 'build', 'construction', 'trade', 'capacity', 'income', 'tax', 'wood', 'stone', 'iron', 'coin', 'cost', 'crown', 'diamond'])) return 'Economy';
		if (has(['defend', 'tower', 'wall', 'air defense', 'sentry', 'fortress', 'castle', 'trap', 'bunker', 'sabotage', 'enemy', 'invading', 'garrison', 'turret', 'radar', 'patrol', 'sniper', 'mortar', 'artillery', 'flak', 'moat'])) return 'Defense';
		if (has(['damage', 'hitpoint', 'infantry', 'cavalry', 'tank', 'apc', 'helicopter', 'bomber', 'fighter', 'general', 'siege', 'raider', 'trooper', 'mercenar', 'deploy', 'attack', 'troop', 'bazooka', 'mrl', 'guerrilla', 'commando', 'paratroop', 'supply', 'sapper', 'healing', 'army', 'victory', 'hero'])) return 'Offense';
		return 'Other';
	};
	// Benefits van een councilor in een chamber, na jouw aanpassingen: gewisseld (sw), verborgen (hd),
	// hernoemd (nm) en zelf toegevoegd (cx).
	const cBen = (n: string, ch: string): any[] => {
		const src = mine.sw.includes(n) ? (ch === 'Primary' ? 'War' : 'Primary') : ch;
		const base = [...(CB.get(`${n}|${src}`)?.values() ?? [])]
			.filter((e) => !mine.hd.includes(`c|${n}|${src}|${e.i}`))
			.map((e) => { const nm = mine.nm[`c|${n}|${src}|${e.i}`]; return nm ? { ...e, b0: e.b, b: nm, dom: domainOf(nm) } : e; });
		const custom = (mine.cx[`${n}|${ch}`] ?? []).map((x, ci) => ({ b: x.b, dom: domainOf(x.b), i: ci, ch, custom: true, Epic: x.Epic, Legendary: x.Legendary, E0: x.Epic, L0: x.Legendary }));
		return [...base, ...custom];
	};
	const cScore = (n: string, ch: string, rar: string) => cBen(n, ch).reduce((s, x) => s + (x[rar] != null && inFocus(x.dom) ? Math.abs(x[rar]) : 0), 0);
	const A = new Map<string, any>();
	D.artifacts.forEach(([n, k, b, dom, st, v]: any[]) => {
		const key = `${n}|${k}`;
		if (!A.has(key)) A.set(key, { id: key, n, k, items: [] });
		A.get(key).items.push({ b, dom, st, v, v0: v, i: A.get(key).items.length });
	});
	const aWiki = [...A.values()].map((a) => ({ ...a, exh: a.k.includes('War') ? 'War' : 'Main' }));
	const AKLASSEN = ['Legendary', 'Legendary War', 'Mythical', 'Mythical War'];
	// Zelf toegevoegde artifacts (mine.ax) staan naast de wiki-artifacts in A; bij elke wijziging opnieuw opgebouwd.
	let aCustom: any[] = [];
	const aAll = () => [...aWiki, ...aCustom];
	function syncCustom(ax: AX[]) {
		aCustom.forEach((a) => A.delete(a.id));
		aCustom = ax.map((x) => {
			const id = `${x.n}|${x.k}`;
			const a = { id, n: x.n, k: x.k, exh: x.k.includes('War') ? 'War' : 'Main', custom: true, items: x.items.map((it, i) => ({ b: it.b, dom: domainOf(it.b), st: null, v: it.v, v0: it.v, i, custom: true })) };
			A.set(id, a);
			return a;
		});
	}
	const aScore = (a: any) => sumAbs(a.items.filter((i: any) => inFocus(i.dom)));

	// ---------- Collectie (lokaal + server) ----------
	// Een councilor in Primary en dezelfde in War zijn twee aparte kaarten: elk met eigen zeldzaamheid en live-status.
	type CM = { rar: string; live: boolean };
	type Cards = { Primary?: CM; War?: CM };
	type AX = { n: string; k: string; items: { b: string; v: number | null }[] };
	type Mine = { ax: AX[]; c: Record<string, Cards>; a: string[]; aOff: string[]; lim: Record<string, number>; ov: Record<string, number>; cx: Record<string, { b: string; Epic: number | null; Legendary: number | null }[]>; nm: Record<string, string>; hd: string[]; sw: string[] };
	const KEY = 'dn-mine';
	const blank = (): Mine => ({ ax: [], c: {}, a: [], aOff: [], lim: {}, ov: {}, cx: {}, nm: {}, hd: [], sw: [] });
	// Leest ook het oude formaat (c als lijst met `off`) en maakt het schoon.
	function norm(m: any): Mine {
		const o = blank();
		if (!m || typeof m !== 'object') return o;
		// Leest ook eerdere formaten: {rar, ch, live|off} en {rar, p, w}.
		const rarOf = (v: any) => (v === 'Epic' ? 'Epic' : 'Legendary');
		const mk = (n: string, x: any): Cards => {
			const o: Cards = {};
			if (x?.Primary || x?.War) { (['Primary', 'War'] as const).forEach((ch) => { if (x[ch]) o[ch] = { rar: rarOf(x[ch].rar), live: x[ch].live !== false }; }); return o; }
			const rar = rarOf(x?.rar);
			if (typeof x?.p === 'boolean' || typeof x?.w === 'boolean') {
				if (x.p) o.Primary = { rar, live: true };
				if (x.w) o.War = { rar, live: true };
				if (!x.p && !x.w) o[cBen(n, 'Primary').length ? 'Primary' : 'War'] = { rar, live: false };
				return o;
			}
			o[x?.ch === 'Primary' ? 'Primary' : 'War'] = { rar, live: x?.live !== undefined ? x.live !== false : !x?.off };
			return o;
		};
		const put = (n: string, x: any) => { if (cNames.includes(n)) { const c = mk(n, x); if (Object.keys(c).length) o.c[n] = { ...c, ...(o.c[n] ?? {}) }; } };
		if (Array.isArray(m.c)) m.c.forEach((x: any) => { if (x?.n) put(x.n, x); });
		else if (m.c && typeof m.c === 'object') Object.entries<any>(m.c).forEach(([n, x]) => put(n, x));
		if (Array.isArray(m.ax)) {
			const seen = new Set(aWiki.map((a) => a.id));
			m.ax.slice(0, 100).forEach((x: any) => {
				const n = String(x?.n ?? '').trim().slice(0, 60), k = AKLASSEN.includes(x?.k) ? x.k : '';
				if (!n || !k || n.includes('|') || seen.has(`${n}|${k}`) || !Array.isArray(x.items)) return;
				seen.add(`${n}|${k}`);
				o.ax.push({ n, k, items: x.items.slice(0, 20).map((it: any) => ({ b: String(it?.b ?? '').slice(0, 60), v: Number.isFinite(+it?.v) && it?.v !== null && it?.v !== '' && Math.abs(+it.v) <= 1000 ? +it.v : null })) });
			});
		}
		syncCustom(o.ax);
		o.a = (Array.isArray(m.a) ? m.a : []).filter((id: any) => A.has(id));
		o.aOff = (Array.isArray(m.aOff) ? m.aOff : []).filter((id: any) => A.has(id));
		if (m.lim && typeof m.lim === 'object') ['cP', 'cW', 'aM', 'aW'].forEach((k) => { if (+m.lim[k] > 0) o.lim[k] = +m.lim[k]; });
		if (m.ov && typeof m.ov === 'object') Object.entries<any>(m.ov).forEach(([k, v]) => { if (/^[ca]\|/.test(k) && Number.isFinite(+v) && Math.abs(+v) <= 1000 && v !== null && v !== '') o.ov[k] = +v; });
		const num = (v: any) => (v !== null && v !== '' && Number.isFinite(+v) && Math.abs(+v) <= 1000 ? +v : null);
		if (m.cx && typeof m.cx === 'object') Object.entries<any>(m.cx).forEach(([k, list]) => { if (/^[^|]+\|(Primary|War)$/.test(k) && Array.isArray(list)) o.cx[k] = list.slice(0, 20).map((x: any) => ({ b: String(x?.b ?? '').slice(0, 60), Epic: num(x?.Epic), Legendary: num(x?.Legendary) })); });
		if (m.nm && typeof m.nm === 'object') Object.entries<any>(m.nm).forEach(([k, v]) => { if (/^c\|/.test(k) && typeof v === 'string' && v.trim()) o.nm[k] = v.slice(0, 60); });
		if (Array.isArray(m.hd)) o.hd = m.hd.filter((k: any) => typeof k === 'string' && /^c\|/.test(k));
		if (Array.isArray(m.sw)) o.sw = m.sw.filter((n: any) => cNames.includes(n));
		return o;
	}
	let mine: Mine = blank();
	try { mine = norm(JSON.parse(localStorage.getItem(KEY) || 'null')); } catch {}
	const isEmpty = (m: Mine) => !Object.keys(m.c).length && !m.a.length && !changes(m);
	const changes = (m: Mine) => Object.keys(m.ov).length + Object.keys(m.nm).length + m.hd.length + m.sw.length + m.ax.length + Object.values(m.cx).reduce((s, l) => s + l.length, 0);
	const KEYSTORE = 'dn-key';
	let pw = '';
	try { pw = localStorage.getItem(KEYSTORE) || ''; } catch {}
	let pushTimer: any;
	const status = (t: string) => { $('m-status').textContent = t; };
	const api = (method: string, body?: string) => fetch('/api/dominations/', { method, headers: { 'x-dn-key': pw, ...(body ? { 'Content-Type': 'application/json' } : {}) }, body });
	const setLimInputs = () => ['cP', 'cW', 'aM', 'aW'].forEach((k) => ($('lim-' + k).value = mine.lim[k] || ''));
	// Eigen aanpassingen (mine.ov) leggen we over de wiki-waarden heen.
	function applyOv() {
		const ov = mine.ov;
		CB.forEach((m, k) => {
			const [n, ch] = k.split('|');
			m.forEach((e) => RAR.forEach((r) => { const key = `c|${n}|${ch}|${e.i}|${r}`; e[r] = key in ov ? ov[key] : r === 'Epic' ? e.E0 : e.L0; }));
		});
		A.forEach((a) => a.items.forEach((it: any) => { const key = `a|${a.id}|${it.i}`; it.v = key in ov ? ov[key] : it.v0; }));
	}
	let editMode = false;
	const numCell = (key: string, cur: number | null, orig: number | null) => {
		const changed = cur !== orig;
		if (editMode) return `<input type="number" step="any" class="dn-num${changed ? ' dn-ov' : ''}" data-act="ov" data-key="${esc(key)}" data-orig="${orig ?? ''}" value="${cur ?? ''}" />%`;
		return cur == null ? '–' : `<b${changed ? ` class="dn-ov" title="wiki: ${orig == null ? 'leeg' : fmt(orig)}"` : ''}>${fmt(cur)}</b>`;
	};
	function setOv(t: any) {
		const key = t.dataset.key, orig = t.dataset.orig === '' ? null : +t.dataset.orig, raw = t.value.trim(), v = raw === '' ? null : +raw;
		if (key.startsWith('a|')) {
			const [, n, k, ai] = key.split('|');
			const it = mine.ax.find((x) => x.n === n && x.k === k)?.items[+ai];
			if (it) { it.v = v !== null && Number.isFinite(v) ? v : null; return saveMine(true); }
		}
		if (key.startsWith('x|')) {
			const [, n, ch, ci, rar] = key.split('|');
			const x = mine.cx[`${n}|${ch}`]?.[+ci];
			if (x) (x as any)[rar] = v !== null && Number.isFinite(v) ? v : null;
			return saveMine(true);
		}
		if (v === null || !Number.isFinite(v) || v === orig) { delete mine.ov[key]; t.value = orig ?? ''; }
		else mine.ov[key] = v;
		t.classList.toggle('dn-ov', key in mine.ov);
		saveMine(true);
	}
	function saveMine(light = false) {
		syncCustom(mine.ax);
		try { localStorage.setItem(KEY, JSON.stringify(mine)); } catch {}
		if (light) { applyOv(); renderM(); updateOvButton(); } else renderAll();
		if (!pw) return;
		clearTimeout(pushTimer);
		status('Opslaan…');
		pushTimer = setTimeout(async () => {
			try { const r = await api('PUT', JSON.stringify(mine)); status(r.ok ? 'Opgeslagen op de server ✓' : (await r.json()).error || 'Opslaan mislukt'); }
			catch { status('Opslaan mislukt (geen verbinding).'); }
		}, 600);
	}
	async function pull() {
		if (!pw) return;
		status('Laden…');
		try {
			const r = await api('GET'), j = await r.json();
			if (r.status === 401) { pw = ''; try { localStorage.removeItem(KEYSTORE); } catch {} $('m-logout').hidden = true; return status('Wachtwoord onjuist.'); }
			if (!r.ok) return status(j.error || 'Laden mislukt');
			$('m-logout').hidden = false; $('m-login').hidden = true; $('m-pw').hidden = true;
			const srv = norm(j.mine);
			if (!isEmpty(srv)) { mine = srv; try { localStorage.setItem(KEY, JSON.stringify(mine)); } catch {} setLimInputs(); renderAll(); status('Ingelogd, collectie geladen van de server ✓'); }
			else if (!isEmpty(mine)) saveMine();
			else status('Ingelogd. Vink items aan; ze worden op de server bewaard.');
		} catch { status('Server niet bereikbaar, lokaal opgeslagen.'); }
	}

	// ---------- Councilors ----------
	let view = 'Primary';
	const cState = { k: 8, d: -1 };
	const typeSel = $('c-type');
	[...new Set(Object.values(TYPES))].sort().forEach((t) => typeSel.insertAdjacentHTML('beforeend', `<option>${esc(t as string)}</option>`));
	const checkbox = (act: string, id: string, on: boolean) => `<input type="checkbox" data-act="${act}" data-id="${esc(id)}"${on ? ' checked' : ''} />`;
	const select = (act: string, id: string, opts: string[], cur: string) => `<select data-act="${act}" data-id="${esc(id)}">${opts.map((o) => `<option${o === cur ? ' selected' : ''}>${o}</option>`).join('')}</select>`;

	function benCell(r: any) {
		const swapped = mine.sw.includes(r.n);
		const line = (b: any) => {
			const k = b.custom ? `x|${r.n}|${view}|${b.i}` : `c|${r.n}|${b.ch}|${b.i}`;
			const name = !editMode ? esc(b.b) : b.custom
				? `<input type="text" class="dn-name dn-ov" data-act="xn" data-id="${esc(r.n)}" data-ci="${b.i}" value="${esc(b.b)}" />`
				: `<input type="text" class="dn-name${mine.nm[k] ? ' dn-ov' : ''}" data-act="nm" data-key="${esc(k)}" data-orig="${esc(b.b0 ?? b.b)}" value="${esc(b.b)}" />`;
			const del = editMode ? `<button class="dn-x" data-act="${b.custom ? 'xdel' : 'hide'}" data-id="${esc(r.n)}" data-key="${esc(k)}" data-ci="${b.i}" title="Verwijder deze benefit">✕</button>` : '';
			return `<span class="dn-ben">${name} ${numCell(`${k}|Epic`, b.Epic, b.E0)} → ${numCell(`${k}|Legendary`, b.Legendary, b.L0)} ${del}</span>`;
		};
		const tools = editMode ? `<div class="dn-tools"><button class="dn-btn" data-act="xadd" data-id="${esc(r.n)}">+ benefit toevoegen</button> <button class="dn-btn${swapped ? ' dn-btn--p' : ''}" data-act="swap" data-id="${esc(r.n)}" title="Wissel de wiki-benefits van Primary en War voor deze councilor">⇄ Primary/War wisselen${swapped ? ' (aan)' : ''}</button></div>` : '';
		const hidden = mine.hd.filter((h) => h.startsWith(`c|${r.n}|`)).length;
		return (r.bens.length ? r.bens.map(line).join('') : '<span class="stat-footnote">Geen benefits in deze chamber</span>') + (editMode && hidden ? ` <span class="stat-footnote">(${hidden} wiki-benefit(s) verborgen)</span>` : '') + tools;
	}
	function renderC() {
		const q = $('c-q').value.toLowerCase(), own = $('c-own').value, type = $('c-type').value;
		const rows = cNames
			.map((n) => {
				const m = mine.c[n]?.[view], other = view === 'Primary' ? 'War' : 'Primary', om = mine.c[n]?.[other], bens = cBen(n, view);
				return { id: n, n, type: TYPES[n] ?? '', own: !!m, live: !!m?.live, rar: m?.rar ?? '', oth: om ? `${other}: ${om.rar}${om.live ? ' · live' : ''}` : '', es: cScore(n, view, 'Epic'), ls: cScore(n, view, 'Legendary'), bens };
			})
			.filter((r) => (!own || (own === 'own') === r.own) && (!type || r.type === type) && (!q || (r.n + ' ' + r.type + ' ' + r.bens.map((b: any) => b.b).join(' ')).toLowerCase().includes(q)));
		const owned = rows.filter((r) => r.own);
		tiles('c-tiles', [['getoond', String(rows.length)], [`in bezit ${view}`, String(owned.length)], [`live ${view}`, String(owned.filter((r) => r.live).length)], [`gem. Legendary Σ (${view})`, r1(mean(rows.map((r) => r.ls)))]]);
		table('c-table', [
			[`Bezit ${view}`, (r: any) => +r.own, (r: any) => checkbox('c-own', r.id, r.own)],
			['Councilor', (r: any) => r.n, (r: any) => `<b>${esc(r.n)}</b>`],
			['Type', (r: any) => r.type, (r: any) => esc(r.type)],
			['Rarity', (r: any) => r.rar, (r: any) => (r.own ? select('c-rar', r.id, RAR, r.rar) : '')],
			[`Live ${view}`, (r: any) => +(r.own && r.live), (r: any) => (r.own ? checkbox('c-live', r.id, r.live) : '')],
			[`Andere chamber`, (r: any) => r.oth, (r: any) => (r.oth ? `<span class="stat-footnote">${r.oth}</span>` : '')],
			[`Epic Σ ${view}`, (r: any) => r.es, (r: any) => (r.es ? r1(r.es) : '')],
			[`Legendary Σ ${view}`, (r: any) => r.ls, (r: any) => (r.ls ? r1(r.ls) : '–')],
			[`Benefits ${view} (Epic → Legendary)`, (r: any) => r.bens.length, (r: any) => benCell(r)],
		], rows, cState);
	}
	$('c-table').addEventListener('change', (e: any) => {
		const t = e.target, id = t.dataset.id, act = t.dataset.act;
		if (!act) return;
		if (act === 'ov') return setOv(t);
		if (act === 'nm') {
			const v = t.value.trim();
			if (!v || v === t.dataset.orig) delete mine.nm[t.dataset.key]; else mine.nm[t.dataset.key] = v.slice(0, 60);
			return saveMine(true);
		}
		if (act === 'xn') { const x = mine.cx[`${id}|${view}`]?.[+t.dataset.ci]; if (x) x.b = t.value.trim().slice(0, 60); return saveMine(true); }
		if (act === 'c-own') {
			if (t.checked) mine.c[id] = { ...(mine.c[id] ?? {}), [view]: { rar: 'Legendary', live: true } };
			else { delete mine.c[id]?.[view as 'Primary' | 'War']; if (!mine.c[id]?.Primary && !mine.c[id]?.War) delete mine.c[id]; }
		}
		else if (act === 'c-live') mine.c[id][view as 'Primary' | 'War']!.live = t.checked;
		else if (act === 'c-rar') mine.c[id][view as 'Primary' | 'War']!.rar = t.value;
		saveMine();
	});
	$('c-table').addEventListener('click', (e: any) => {
		const t = e.target.closest('button[data-act]');
		if (!t) return;
		const id = t.dataset.id, act = t.dataset.act, ck = `${id}|${view}`;
		if (act === 'xadd') (mine.cx[ck] ??= []).push({ b: 'Nieuwe benefit', Epic: null, Legendary: null });
		else if (act === 'xdel') { mine.cx[ck].splice(+t.dataset.ci, 1); if (!mine.cx[ck].length) delete mine.cx[ck]; }
		else if (act === 'hide') mine.hd.push(t.dataset.key);
		else if (act === 'swap') mine.sw = mine.sw.includes(id) ? mine.sw.filter((x) => x !== id) : [...mine.sw, id];
		else return;
		saveMine();
	});
	['c-q', 'c-own', 'c-type'].forEach((id) => $(id).addEventListener('input', renderC));
	$('c-view').querySelectorAll('button').forEach((b: HTMLElement) => b.addEventListener('click', () => {
		view = b.dataset.v!;
		$('c-view').querySelectorAll('button').forEach((x: HTMLElement) => x.classList.toggle('is-active', x === b));
		renderC();
	}));

	// ---------- Artifacts ----------
	const aState = { k: 5, d: -1 };
	function renderA() {
		const q = $('a-q').value.toLowerCase(), exh = $('a-exh').value, kl = $('a-klass').value, own = $('a-own').value;
		const off = new Set(mine.aOff), have = new Set(mine.a);
		const rows = aAll()
			.filter((a) => (!exh || a.exh === exh) && (!kl || a.k === kl) && (!own || (own === 'own') === have.has(a.id)) && (!q || (a.n + ' ' + a.items.map((i: any) => i.b).join(' ')).toLowerCase().includes(q)))
			.map((a) => ({ ...a, own: have.has(a.id), live: have.has(a.id) && !off.has(a.id), score: aScore(a) }));
		const owned = rows.filter((r) => r.own);
		tiles('a-tiles', [['getoond', String(rows.length)], ['in bezit', String(owned.length)], ['live', String(owned.filter((r) => r.live).length)], ['gem. totaal', r1(mean(rows.map((r) => r.score)))]]);
		table('a-table', [
			['Bezit', (r: any) => +r.own, (r: any) => checkbox('a-own', r.id, r.own)],
			['Live', (r: any) => +r.live, (r: any) => (r.own ? checkbox('a-live', r.id, r.live) : '')],
			['Artifact', (r: any) => r.n, (r: any) => `<b>${esc(r.n)}</b>${r.custom ? ' <span class="stat-footnote">(eigen)</span>' : ''}${r.custom && editMode ? `<div class="dn-tools"><button class="dn-btn" data-act="axrm" data-id="${esc(r.id)}">Verwijder artifact</button></div>` : ''}`],
			['Klasse', (r: any) => r.k, (r: any) => r.k],
			['Aantal', (r: any) => r.items.length, (r: any) => r.items.length],
			['Totaal', (r: any) => r.score, (r: any) => r1(r.score)],
			['Benefits', (r: any) => r.items.length, (r: any) => r.items.map((i: any) => `<span class="dn-ben">${i.custom && editMode ? `<input type="text" class="dn-name dn-ov" data-act="axn" data-id="${esc(r.id)}" data-ci="${i.i}" value="${esc(i.b)}" />` : esc(i.b)} ${numCell(`a|${r.id}|${i.i}`, i.v, i.v0)}${i.custom && editMode ? ` <button class="dn-x" data-act="axdi" data-id="${esc(r.id)}" data-ci="${i.i}" title="Verwijder deze benefit">✕</button>` : ''}</span>`).join('') + (r.custom && editMode ? `<div class="dn-tools"><button class="dn-btn" data-act="axadd" data-id="${esc(r.id)}">+ benefit toevoegen</button></div>` : '')],
		], rows, aState);
	}
	const findAx = (id: string) => mine.ax.find((x) => `${x.n}|${x.k}` === id);
	$('a-table').addEventListener('click', (e: any) => {
		const t = e.target.closest('button[data-act]');
		if (!t) return;
		const id = t.dataset.id, act = t.dataset.act, x = findAx(id);
		if (!x) return;
		if (act === 'axadd') { if (x.items.length < 20) x.items.push({ b: 'Nieuwe benefit', v: null }); }
		else if (act === 'axdi') x.items.splice(+t.dataset.ci, 1);
		else if (act === 'axrm') { if (!confirm(`Artifact "${x.n}" verwijderen?`)) return; mine.ax = mine.ax.filter((y) => y !== x); mine.a = mine.a.filter((i) => i !== id); mine.aOff = mine.aOff.filter((i) => i !== id); }
		else return;
		saveMine();
	});
	$('a-add-btn').addEventListener('click', () => {
		const n = $('a-add-n').value.trim().slice(0, 60), k = $('a-add-k').value;
		if (!n) return alert('Geef het artifact een naam.');
		if (n.includes('|')) return alert('Gebruik geen | in de naam.');
		if (A.has(`${n}|${k}`)) return alert('Dit artifact (met deze klasse) staat al in de lijst.');
		mine.ax.push({ n, k, items: [{ b: 'Nieuwe benefit', v: null }] });
		$('a-add-n').value = '';
		$('a-q').value = n;
		saveMine();
	});
	$('a-table').addEventListener('change', (e: any) => {
		const t = e.target, id = t.dataset.id, act = t.dataset.act;
		if (!act) return;
		if (act === 'ov') return setOv(t);
		if (act === 'axn') { const x = findAx(id); if (x) x.items[+t.dataset.ci].b = t.value.trim().slice(0, 60); return saveMine(true); }
		if (act === 'a-own') { if (t.checked) { if (!mine.a.includes(id)) mine.a.push(id); } else { mine.a = mine.a.filter((x) => x !== id); mine.aOff = mine.aOff.filter((x) => x !== id); } }
		else if (act === 'a-live') mine.aOff = t.checked ? mine.aOff.filter((x) => x !== id) : [...new Set([...mine.aOff, id])];
		saveMine();
	});
	['a-q', 'a-exh', 'a-klass', 'a-own'].forEach((id) => $(id).addEventListener('input', renderA));

	// ---------- Mijn stats + advies ----------
	const mState = { k: 4, d: -1 };
	function renderM() {
		const tot = new Map<string, { dom: string; c: number; a: number }>();
		const add = (b: string, dom: string, key: 'c' | 'a', v: number) => {
			if (!tot.has(b)) tot.set(b, { dom, c: 0, a: 0 });
			tot.get(b)![key] += v;
		};
		// Alle kaarten als lijst: {n, ch, rar, live}
		const cards = Object.entries(mine.c).flatMap(([n, c]) => (['Primary', 'War'] as const).filter((ch) => c[ch]).map((ch) => ({ n, ch, rar: c[ch]!.rar, live: c[ch]!.live })));
		const liveC = cards.filter((k) => k.live);
		liveC.forEach((k) => cBen(k.n, k.ch).forEach((x) => { if (x[k.rar] != null) add(x.b, x.dom, 'c', x[k.rar]); }));
				const off = new Set(mine.aOff), ownedA = mine.a.map((id) => A.get(id)).filter(Boolean);
		const liveA = ownedA.filter((a: any) => !off.has(a.id));
		liveA.forEach((a: any) => a.items.forEach((x: any) => { if (x.v != null) add(x.b, x.dom, 'a', x.v); }));

		const rows = [...tot].map(([b, o]) => ({ id: b, b, dom: o.dom, c: o.c, a: o.a, t: o.c + o.a })).filter((r) => inFocus(r.dom));
		const dom = (d: string) => rows.filter((r) => r.dom === d).reduce((s, r) => s + Math.abs(r.t), 0);
		const lim = mine.lim, cnt = (n: number, l: number) => `${n}${l ? '/' + l : ''}${l && n > l ? ' ⚠' : ''}`;
		const cP = liveC.filter((k) => k.ch === 'Primary').length, cW = liveC.filter((k) => k.ch === 'War').length;
		const aW = liveA.filter((a: any) => a.k.includes('War')).length, aM = liveA.length - aW;
		tiles('m-tiles', [['Primary live', cnt(cP, lim.cP)], ['War live', cnt(cW, lim.cW)], ['artifacts main live', cnt(aM, lim.aM)], ['artifacts war live', cnt(aW, lim.aW)], ['aanval', r1(dom('Offense'))], ['verdediging', r1(dom('Defense'))], ['economie', r1(dom('Economy'))]]);
		table('m-totals', [
			['Benefit', (r: any) => r.b, (r: any) => esc(r.b)],
			['Soort', (r: any) => r.dom, (r: any) => r.dom],
			['Councilors', (r: any) => Math.abs(r.c), (r: any) => (r.c ? fmt(r.c) : '')],
			['Artifacts', (r: any) => Math.abs(r.a), (r: any) => (r.a ? fmt(r.a) : '')],
			['Totaal', (r: any) => Math.abs(r.t), (r: any) => `<b>${fmt(r.t)}</b>`],
		], rows, mState);

		const adv: string[] = [];
		const list = (title: string, items: string[], note = '') => adv.push(`<div><h3>${title}</h3>${note ? `<p class="stat-footnote">${note}</p>` : ''}${items.length ? '<ol>' + items.map((x) => `<li>${x}</li>`).join('') + '</ol>' : '<p class="stat-footnote">Niets te adviseren.</p>'}</div>`);
		const ups = cards.filter((k) => k.rar === 'Epic').map((k) => ({ k, gain: cScore(k.n, k.ch, 'Legendary') - cScore(k.n, k.ch, 'Epic') })).filter((x) => x.gain > 0).sort((x, y) => y.gain - x.gain).slice(0, 6);
		list('Councilors naar Legendary', ups.map((u) => `<b>${esc(u.k.n)}</b> (${u.k.ch}): +${r1(u.gain)}`), 'Winst in stat-punten (binnen je focus).');
		const best = cNames.flatMap((n) => (['Primary', 'War'] as const).filter((ch) => !mine.c[n]?.[ch]).map((ch) => ({ n, ch, v: cScore(n, ch, 'Legendary') }))).filter((x) => x.v > 0).sort((x, y) => y.v - x.v).slice(0, 6);
		list('Councilor-kaarten om te zoeken (Legendary)', best.map((x) => `<b>${esc(x.n)}</b> in ${x.ch}: ${r1(x.v)}`), 'Kaarten die je nog niet hebt, per chamber.');
				const mUp = ownedA.map((a: any) => {
			const m2 = a.k.startsWith('Legendary') ? A.get(`${a.n}|${a.k.replace('Legendary', 'Mythical')}`) : null;
			return m2 ? { a, gain: aScore(m2) - aScore(a) } : null;
		}).filter((x: any) => x && x.gain > 0).sort((x: any, y: any) => y.gain - x.gain).slice(0, 6) as any[];
		list('Artifacts naar Mythical', mUp.map((u) => `<b>${esc(u.a.n)}</b> (${u.a.k}): +${r1(u.gain)}`), 'Mythical-variant van een artifact dat je al hebt.');
		const have = new Set(mine.a);
		const bestA = aAll().filter((a) => !have.has(a.id)).map((a) => ({ a, v: aScore(a) })).filter((x) => x.v > 0).sort((x, y) => y.v - x.v).slice(0, 6);
		list('Sterkste artifacts die je mist', bestA.map((x) => `<b>${esc(x.a.n)}</b> (${x.a.k}): ${r1(x.v)}`));
		const sleeping = [
			...cards.filter((k) => !k.live).map((k) => ({ t: `${esc(k.n)} (${k.ch}, ${k.rar})`, v: cScore(k.n, k.ch, k.rar) })),
			...ownedA.filter((a: any) => off.has(a.id)).map((a: any) => ({ t: `${esc(a.n)} (${a.k})`, v: aScore(a) })),
		].filter((x) => x.v > 0).sort((x, y) => y.v - x.v).slice(0, 6);
		list('In bezit maar niet live', sleeping.map((x) => `<b>${x.t}</b>: ${r1(x.v)}`), 'Overweeg deze live te zetten als je slots het toelaten.');
		$('m-advice').innerHTML = adv.join('');
	}
	function updateOvButton() {
		const n = changes(mine);
		$('m-ovreset').hidden = !n;
		$('m-ovreset').textContent = `Reset aanpassingen (${n})`;
	}
	function renderAll() { applyOv(); renderC(); renderA(); renderM(); updateOvButton(); }

	// ---------- Bediening ----------
	$('m-focus').addEventListener('input', renderAll);
	$('m-edit').addEventListener('click', () => {
		editMode = !editMode;
		$('m-edit').classList.toggle('dn-btn--p', editMode);
		$('a-add').hidden = !editMode;
		$('m-edit').textContent = editMode ? 'Klaar met bewerken' : 'Waarden bewerken';
		renderAll();
	});
	$('m-ovreset').addEventListener('click', () => { if (confirm('Al je aanpassingen (percentages, namen, verwijderde, toegevoegde benefits en artifacts en gewisselde chambers) terugzetten naar de wiki?')) { mine.ov = {}; mine.nm = {}; mine.hd = []; mine.sw = []; mine.cx = {}; mine.a = mine.a.filter((id) => !mine.ax.some((x) => `${x.n}|${x.k}` === id)); mine.aOff = mine.aOff.filter((id) => !mine.ax.some((x) => `${x.n}|${x.k}` === id)); mine.ax = []; saveMine(); } });
	['cP', 'cW', 'aM', 'aW'].forEach((k) => $('lim-' + k).addEventListener('input', () => { mine.lim[k] = Math.max(0, +$('lim-' + k).value || 0); saveMine(); }));
	$('m-clear').addEventListener('click', () => { if (confirm('Je hele collectie wissen?')) { mine = blank(); setLimInputs(); saveMine(); } });
	$('m-export').addEventListener('click', () => prompt('Kopieer deze tekst om je collectie te bewaren:', JSON.stringify(mine)));
	$('m-import').addEventListener('click', () => {
		const t = prompt('Plak eerder geëxporteerde collectie-tekst:');
		if (!t) return;
		try { mine = norm(JSON.parse(t)); setLimInputs(); saveMine(); } catch { alert('Ongeldige tekst.'); }
	});
	$('m-login').addEventListener('click', () => { pw = $('m-pw').value; if (!pw) return; try { localStorage.setItem(KEYSTORE, pw); } catch {} $('m-pw').value = ''; pull(); });
	$('m-pw').addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') $('m-login').click(); });
	$('m-logout').addEventListener('click', () => { pw = ''; try { localStorage.removeItem(KEYSTORE); } catch {} $('m-logout').hidden = true; $('m-login').hidden = false; $('m-pw').hidden = false; status('Uitgelogd: alleen in deze browser opgeslagen.'); });
	document.querySelectorAll('.dn-tab').forEach((t: any) =>
		t.addEventListener('click', () => {
			document.querySelectorAll('.dn-tab').forEach((x) => x.classList.toggle('is-active', x === t));
			$('dn-c').hidden = t.dataset.tab !== 'c';
			$('dn-a').hidden = t.dataset.tab !== 'a';
		}));
	setLimInputs();
	renderAll();
	pull();
</script>

<style is:global>
	.dn h2 { font-size: 1.1rem; margin: 1.75rem 0 0.75rem; }
	.dn h3 { font-size: 1rem; margin: 0 0 0.4rem; }
	.dn ol { padding-left: 1.2rem; font-size: 0.9rem; line-height: 1.7; }
	.dn-box { border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 0.75rem 1rem 0.25rem; margin: 1rem 0; background: var(--color-bg-alt); }
	.dn-tabs { display: flex; gap: 0.5rem; margin: 1.25rem 0; }
	.dn-tab { border: 1px solid var(--color-border); background: var(--color-bg-alt); color: var(--color-text); padding: 0.5rem 1.1rem; border-radius: 999px; font: inherit; cursor: pointer; }
	.dn-tab.is-active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
	.dn-filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.75rem; align-items: center; }
	.dn-filters input, .dn-filters select { font: inherit; padding: 0.5rem 0.7rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); }
	.dn-filters input[type='search'] { flex: 1 1 14rem; }
	.dn-filters[hidden] { display: none; }
	.dn-lim, .dn-login { font-size: 0.85rem; }
	.dn-lim input { width: 4rem; padding: 0.3rem 0.4rem; }
	.dn-login input { max-width: 14rem; }
	.dn-seg { display: inline-flex; border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
	.dn-seg button { font: inherit; padding: 0.5rem 1rem; border: 0; background: var(--color-bg); color: var(--color-text); cursor: pointer; }
	.dn-seg button.is-active { background: var(--color-primary); color: #fff; }
	.dn-btn { font: inherit; font-size: 0.85rem; padding: 0.4rem 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); cursor: pointer; }
