---
// Overzicht van alle berichten, gesorteerd op datum (nieuwste eerst).
// Vervangt de WordPress "Recente berichten"-widget/subapplicatie: dit is nu
// gewoon een directe query op de content collection.
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<PageLayout title="Berichten" description="Alle berichten en artikelen.">
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<a href={`/${post.id}/`}>{post.data.title}</a>
				<time datetime={post.data.date.toISOString()}>
					{post.data.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}
				</time>
			</li>
		))}
	</ul>
</PageLayout>
