---
// Overzicht van downloadbare documenten/PDF's uit src/content/documents/.
// Zet de PDF's zelf in public/docs/ (zie public/docs/README.md).
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const documents = (await getCollection('documents')).sort(
	(a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
---

<PageLayout title="Documenten" description="Downloadbare documenten en formulieren." prose={false}>
	{documents.length === 0 ? (
		<p>Er zijn nog geen documenten toegevoegd.</p>
	) : (
		<ul class="card-grid">
			{documents.map((doc) => (
				<ArticleCard href={doc.data.file} title={doc.data.title} description={doc.data.description} linkLabel="Download" />
			))}
		</ul>
	)}
</PageLayout>
