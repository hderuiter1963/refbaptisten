---
// Rendert elke pagina uit content/pages/, elk bericht uit content/posts/ en
// elk artikel uit content/publications/ automatisch op /<slug>/ (allemaal op
// de root, gelijk aan de oorspronkelijke WordPress-URL's).
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostLayout from '../layouts/PostLayout.astro';
import PublicationLayout from '../layouts/PublicationLayout.astro';

export async function getStaticPaths() {
	const pages = await getCollection('pages');
	const posts = await getCollection('posts');
	const publications = await getCollection('publications');

	return [
		...pages
			.filter((page) => page.id !== 'documenten') // heeft een eigen pagina met listing-logica
			.map((page) => ({
				params: { slug: page.id },
				props: { kind: 'page' as const, entry: page },
			})),
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { kind: 'post' as const, entry: post },
		})),
		...publications.map((pub) => ({
			params: { slug: pub.id },
			props: { kind: 'publication' as const, entry: pub },
		})),
	];
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---

{kind === 'post' && (
	<PostLayout title={entry.data.title} date={entry.data.date} description={entry.data.description} category={entry.data.category} image={entry.data.image}>
		<Content />
	</PostLayout>
)}
{kind === 'publication' && (
	<PublicationLayout title={entry.data.title} category={entry.data.category} description={entry.data.description} image={entry.data.image}>
		<Content />
	</PublicationLayout>
)}
{kind === 'page' && (
	<PageLayout title={entry.data.title} description={entry.data.description} scripture={entry.data.scripture}>
		<Content />
	</PageLayout>
)}
