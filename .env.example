# Kopieer dit bestand niet naar .env in git — vul deze waarden in bij
# Vercel: Project → Settings → Environment Variables.
# Voor lokaal testen (npm run dev) mag je wél een eigen .env-bestand maken
# (die staat al in .gitignore).

# SMTP-instellingen voor het contactformulier (src/pages/api/contact.ts).
# Voor een persoonlijk Outlook/Hotmail-account:
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=jouw-adres@outlook.com
# Gebruik een "app-wachtwoord", niet je gewone inlogwachtwoord
# (aanmaken via: account.microsoft.com/security → geavanceerde beveiligingsopties)
SMTP_PASS=

# Optioneel: ontvangend adres als dat anders is dan SMTP_USER
# CONTACT_TO=info@refbaptisten.nl

# Optioneel: vertaalt de titels/samenvattingen van het wereldnieuws-blok naar
# het Nederlands tijdens de build (src/lib/news.ts). Zonder sleutel blijft
# alles Engels. Instellen in Vercel (Production + Preview).
# ANTHROPIC_API_KEY=
